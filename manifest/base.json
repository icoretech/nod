{
  "manifest_version": 3,
  "name": "Nod: Follows You badge for X",
  "short_name": "Nod",
  "version": "0.1.1",
  "description": "See who follows you back on X (Twitter): Mutual, Follows you or Doesn't follow you, next to every name. Private, no tracking.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
